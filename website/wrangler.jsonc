{
  // Keep this name: `.github/scripts/upload-worker-preview.sh` targets the
  // `common-grants` Worker by name and publishes PR previews as versions of it.
  "name": "common-grants",
  "compatibility_date": "2025-08-01",
  // `nodejs_compat` is required by the `@astrojs/cloudflare` adapter (#1078),
  // not by the mock itself: the adapter prerenders the static pages inside a
  // workerd sandbox, and the site's build-time code (schema loaders, content
  // collections) imports `node:fs`. Without this flag the build fails at the
  // "prerendering static routes" step with `No such module "node:fs"`.
  "compatibility_flags": ["nodejs_compat"],
  // No `main` here on purpose. The adapter injects one during the build
  // (`main: config.main ?? "@astrojs/cloudflare/entrypoints/server"`), and
  // hardcoding the built path instead makes the build fail before it can create
  // it — `@cloudflare/vite-plugin` validates `main` while resolving config.
  //
  // Which means this file alone is NOT deployable: without `main` it describes an
  // assets-only Worker, so `/api/*` would 404 while the docs still served. Deploys
  // and local previews must pass the config the build generates, which carries the
  // built `main` and its own `assets.directory`:
  //
  //   wrangler dev    --config dist/server/wrangler.json
  //   wrangler deploy --config dist/server/wrangler.json
  //
  // See `preview:wrangler` in package.json and the upload step in
  // `.github/workflows/ci-website-preview.yml`.
  "assets": {
    // `dist/client`, not `dist`: the adapter splits the build output, and `dist`
    // itself holds no site files. Pointed at the right place so a bare wrangler
    // invocation degrades to "docs without the API" rather than serving nothing.
    "directory": "./dist/client",
  },
}
