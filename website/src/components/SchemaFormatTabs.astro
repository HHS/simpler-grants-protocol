---
import { Code } from "@astrojs/starlight/components";
import { Tabs, TabItem } from "@astrojs/starlight/components";
import { readFileSync } from "fs";
import { join } from "path";
import { Paths } from "../lib/schema/paths";
import { generateSchemaExample } from "../lib/schema/example-generator";
import { schemaFilePath } from "../lib/schema/schema-files";
import { SchemaDocMapper } from "../lib/schema/schema-doc-mapper";
import {
  findSnippet,
  sourceUrl,
  type SourceLanguage,
} from "../lib/schema/source-declarations";

/**
 * A literal code block, or a file to read whole. Pages give literal code for
 * hand-written examples and inline JSON Schemas.
 */
interface CodeBlockConfig {
  /** A literal code block to display. If provided, file is ignored. */
  code?: string;
  /**
   * A JSON Schema file to display, by its path relative to the repository
   * root. Only `jsonSchema` reads it: the custom field catalog passes its
   * extension schema this way. Examples are literal code or generated from
   * `schema`.
   */
  file?: {
    path: string;
  };
}

/**
 * A source code tab: `true` shows the declaration named after the schema
 * (`Money` in TypeSpec and Python, `MoneySchema` in TypeScript); a string
 * names the declaration to show, for code named differently from the schema;
 * a list of names shows several declarations from one file, such as a
 * template and the model built from it.
 */
type SourceTab = true | string | string[];

/**
 * Props for the SchemaFormatTabs component.
 *
 * Name a schema with `schema` and the Example and JSON Schema tabs come from
 * its generated JSON Schema file. Each source tab listed is found by name in
 * the TypeSpec or SDK source; the build fails if it can't be found.
 */
interface Props {
  /** The schema's name, which is also the name of its generated JSON Schema file */
  schema?: string;
  /** Example JSON: literal code overrides the example generated from the schema */
  example?: Pick<CodeBlockConfig, "code">;
  /** JSON Schema: literal code for schemas with no generated file */
  jsonSchema?: CodeBlockConfig;
  /** TypeSpec tab */
  typeSpec?: SourceTab;
  /** Python tab */
  python?: SourceTab;
  /** TypeScript tab */
  typescript?: SourceTab;
}

const { schema, example, jsonSchema, typeSpec, python, typescript } =
  Astro.props;

// The schema file the Example and JSON Schema tabs read, if the page named one
const schemaPath = schema && !jsonSchema ? schemaFilePath(schema) : undefined;
const jsonSchemaConfig: CodeBlockConfig | undefined =
  jsonSchema ?? (schemaPath ? { file: { path: schemaPath } } : undefined);

// Validate that at least one tab is provided
if (!example && !jsonSchemaConfig && !typeSpec && !python && !typescript) {
  throw new Error("SchemaFormatTabs requires at least one tab to be provided");
}

const exampleCode = example?.code
  ? example.code
  : schemaPath
    ? await generateSchemaExample(schemaPath)
    : null;
const jsonSchemaCode = jsonSchemaConfig ? extractCode(jsonSchemaConfig) : null;
const jsonSchemaUrl = jsonSchemaConfig
  ? extractSchemaUrl(jsonSchemaConfig)
  : null;

// In the dev server, re-read the sources and pages once per page render so an
// edit shows on reload; a production build reads them once.
if (import.meta.env.DEV) {
  SchemaDocMapper.refreshForRender(Astro.locals);
}
const typeSpecSnippet = snippet("typeSpec", typeSpec);
const pythonSnippet = snippet("python", python);
const typescriptSnippet = snippet("typescript", typescript);

/**
 * Finds the declaration a source tab shows.
 * @returns The declaration's code and a link to it, or null if the tab isn't shown
 * @throws Error if the declaration can't be found
 */
function snippet(
  language: SourceLanguage,
  requested: SourceTab | undefined,
): { code: string; url: string } | null {
  if (!requested) {
    return null;
  }
  const declaration = findSnippet(language, requested, schema);
  return { code: declaration.code, url: sourceUrl(declaration) };
}

/**
 * Constructs a schema URL from file path.
 * @param props - The code block configuration
 * @returns The schema URL for the file, or null if no file is specified
 */
function extractSchemaUrl(props: CodeBlockConfig): string | null {
  if (!props.file) {
    return null;
  }
  // Extension schemas live in .extension-schemas (gitignored); no hosted link
  if (props.file.path.includes(Paths.EXTENSION_SCHEMAS_PATH_PREFIX)) {
    return null;
  }

  // public/ is served at the site root, so trim "website/public/" off the stored
  // path to get the URL. Use the relative PUBLIC_PATH_PREFIX, not absolute PUBLIC_DIR.
  const pathPrefix = `${Paths.PUBLIC_PATH_PREFIX}/`;
  let filePath = props.file.path;

  if (filePath.startsWith(pathPrefix)) {
    filePath = filePath.substring(pathPrefix.length);
  }

  return `/${filePath}`;
}

/**
 * Extracts code from either a literal string or a file.
 * @param props - The code block configuration
 * @returns The extracted code as a string
 * @throws Error if file cannot be read or if neither code nor file is provided
 */
function extractCode(props: CodeBlockConfig): string {
  if (props.code) {
    return props.code;
  }
  if (props.file) {
    try {
      return readFileSync(join(Paths.REPO_ROOT, props.file.path), "utf-8");
    } catch (error) {
      throw new Error(`Error reading file ${props.file.path}: ${error}`, {
        cause: error,
      });
    }
  }
  throw new Error("Either code or file must be provided");
}
---

<Tabs>
  {
    exampleCode && (
      <TabItem label="Example">
        <p>A JSON example of this model.</p>
        <Code code={exampleCode} lang="json" />
      </TabItem>
    )
  }
  {
    jsonSchemaCode && (
      <TabItem label="JSON Schema">
        <p>
          {jsonSchemaUrl ? (
            <>
              {"The "}
              <a href={jsonSchemaUrl} target="_blank" rel="noopener noreferrer">
                JSON Schema
              </a>
              {" for this model."}
            </>
          ) : (
            "The JSON Schema for this model."
          )}
        </p>
        <Code code={jsonSchemaCode} lang="yaml" />
      </TabItem>
    )
  }
  {
    typeSpecSnippet && (
      <TabItem label="TypeSpec">
        <p>
          {"The "}
          <a
            href={typeSpecSnippet.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            TypeSpec code
          </a>
          {" for this model."}
        </p>
        <Code code={typeSpecSnippet.code} lang="typespec" />
      </TabItem>
    )
  }
  {
    pythonSnippet && (
      <TabItem label="Python">
        <p>
          {"The "}
          <a href={pythonSnippet.url} target="_blank" rel="noopener noreferrer">
            Python code
          </a>
          {" for this model."}
        </p>
        <Code code={pythonSnippet.code} lang="python" />
      </TabItem>
    )
  }
  {
    typescriptSnippet && (
      <TabItem label="TypeScript">
        <p>
          {"The "}
          <a
            href={typescriptSnippet.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            TypeScript code
          </a>
          {" for this model."}
        </p>
        <Code code={typescriptSnippet.code} lang="typescript" />
      </TabItem>
    )
  }
</Tabs>
