---
import CatalogCard from "@/components/catalog/CatalogCard.astro";

interface Props {
  /** Field name as the implementation returns it */
  name: string;
  /** JSON schema type of the field's value */
  fieldType: string;
  /** What the field holds */
  description: string;
}

const { name, fieldType, description } = Astro.props;
---

<!-- No href: these fields have no catalog page to link to -->
<CatalogCard title={name} description={description} dataAttributes={{}}>
  <div class="card-type">
    <span class="type-badge">{fieldType}</span>
  </div>
</CatalogCard>

<style>
  .card-type {
    margin-bottom: 0.5rem;
  }

  .type-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    border-radius: 0.375rem;
    font-family: monospace;
    font-size: 0.875rem;
    line-height: 1;
    width: fit-content;
  }
</style>
