{
  "ts-cg-grants-gov": {
    "label": "TypeScript Grants.gov Plugin",
    "description": "A TypeScript adapter that maps Grants.gov opportunity data to the CommonGrants protocol.",
    "system": "Grants.gov",
    "packageName": "@common-grants/cg-grants-gov",
    "packageUrl": "https://www.npmjs.com/package/@common-grants/cg-grants-gov",
    "fields": {
      "Opportunity": [
        "legacySerialId",
        "federalOpportunityNumber",
        "assistanceListings",
        "agency",
        "attachments",
        "federalFundingSource",
        "contactInfo",
        "additionalInfo",
        "fiscalYear",
        "costSharing"
      ]
    },
    "filters": {
      "opportunities": {
        "search": {
          "agency": {
            "filterType": "stringArray",
            "description": "Filter by funding agency."
          },
          "applicantType": {
            "filterType": "stringArray",
            "description": "Filter by eligible applicant type."
          },
          "fundingInstrument": {
            "filterType": "stringArray",
            "description": "Filter by funding instrument."
          },
          "costSharing": {
            "filterType": "booleanComparison",
            "description": "Filter by whether cost sharing is required."
          }
        }
      }
    }
  },
  "cg-grants-gov": {
    "label": "Python Grants.gov Plugin",
    "description": "A Python adapter that maps Grants.gov opportunity data to the CommonGrants protocol.",
    "system": "Grants.gov",
    "packageName": "cg-grants-gov",
    "packageUrl": "https://pypi.org/project/cg-grants-gov/",
    "repoUrl": "https://github.com/common-grants/py-cg-grants-gov",
    "fields": {
      "Opportunity": [
        "legacySerialId",
        "federalOpportunityNumber",
        "assistanceListings",
        "agency",
        "attachments",
        "federalFundingSource",
        "contactInfo",
        "additionalInfo",
        "fiscalYear",
        "costSharing"
      ]
    },
    "filters": {
      "opportunities": {
        "search": {
          "agency": {
            "filterType": "stringArray",
            "description": "Filter by funding agency."
          },
          "applicantType": {
            "filterType": "stringArray",
            "description": "Filter by eligible applicant type."
          },
          "fundingInstrument": {
            "filterType": "stringArray",
            "description": "Filter by funding instrument."
          },
          "costSharing": {
            "filterType": "booleanComparison",
            "description": "Filter by whether cost sharing is required."
          }
        }
      }
    }
  }
}
