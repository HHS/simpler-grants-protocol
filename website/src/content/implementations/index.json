      },
      "waMinAwardAmountRaw": {
        "fieldType": "string",
        "description": "Original minimum award value"
      },
      "waMaxAwardAmountRaw": {
        "fieldType": "string",
        "description": "Original maximum award value"
      },
      "waDisbursementNotes": {
        "fieldType": "string",
        "description": "FundHubWA disbursement notes"
      },
      "waApplicationCloseTime": {
        "fieldType": "string",
