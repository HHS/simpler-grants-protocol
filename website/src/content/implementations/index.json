{
  "simpler-grants": {
    "name": "Simpler.Grants.gov API",
    "description": "Federal grant opportunities from Simpler.Grants.gov, served through CommonGrants routes.",
    "maintainer": "U.S. Department of Health and Human Services",
    "scope": ["Federal"],
    "sources": [
      {
        "name": "Grants.gov",
        "url": "https://www.grants.gov/"
      }
    ],
    "routes": [
      "GET /common-grants/opportunities",
      "GET /common-grants/opportunities/{oppId}",
      "POST /common-grants/opportunities/search"
    ],
    "apiUrl": "https://api.simpler.grants.gov/common-grants",
    "docsUrl": "https://api.simpler.grants.gov/docs",
    "sourceUrl": "https://github.com/HHS/simpler-grants-gov",
    "license": "CC0-1.0",
    "auth": "Free API key",
    "authUrl": "https://simpler.grants.gov/developers",
    "customFields": [
      "legacySerialId",
      "federalOpportunityNumber",
      "assistanceListings",
      "agency",
      "attachments",
      "federalFundingSource",
      "contactInfo",
      "additionalInfo",
      "fiscalYear",
      "costSharing"
    ],
    "customFilters": [
      "agency",
      "applicantType",
      "fundingInstrument",
      "costSharing"
    ],
    "plugins": ["ts-cg-grants-gov", "cg-grants-gov"]
  },
  "maryland": {
    "name": "Maryland Community Compass",
    "description": "Grant programs available in Maryland at the statewide, county, municipal, and regional level, from Maryland Community Compass.",
    "note": "Built by Agile Six as a reference implementation, using public data from Maryland Community Compass.",
    "maintainer": "Agile Six",
    "scope": ["State", "Local", "Federal", "Private"],
    "sources": [
      {
        "name": "Maryland Community Compass",
        "url": "https://compass.maryland.gov/incentives/"
      }
    ],
    "routes": [
      "GET /common-grants/opportunities",
      "GET /common-grants/opportunities/{oppId}",
      "POST /common-grants/opportunities/search"
    ],
    "apiUrl": "https://md.api.cg.a6lab.ai/common-grants",
    "docsUrl": "https://md.api.cg.a6lab.ai/docs",
    "sourceUrl": "https://github.com/agilesix/cg-api-md",
    "license": "MIT",
    "auth": "None",
    "refresh": "Daily",
    "customFields": ["agency", "contactInfo", "additionalInfo"],
    "sourceSpecificFields": [
      "eligibilityCriteria",
      "attachments",
      "fundingSource",
      "fundingInstrument",
      "lastSyncedAt",
      "mdCompassId",
      "mdSlug",
      "mdDataQuality",
      "mdGeographicScope",
      "mdAcceptingApplications",
      "mdRecurring",
      "mdAssistanceTypes",
      "mdEligibleIndustries",
      "mdEligibleCounties",
      "mdEligibleMunicipalities",
      "mdEligibleRegions",
      "mdEligibleIncentiveAreas",
      "mdEligibleOrganizationTypes",
      "mdBusinessStage",
      "mdApplicationDeadlineRaw",
      "mdApplicationProcess",
      "mdProgramAudience",
      "mdUseOfFunds",
      "mdGeographicEligibility",
      "mdRequirements",
      "mdSourceUrls",
      "mdSourceCount"
    ]
  },
