---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import "swagger-ui-dist/swagger-ui.css";
import { isMockApiEnabled } from "@/lib/mock/docs-wiring";

// Available OpenAPI versions (mirror of the emitted specs in public/openapi/)
const availableVersions = [
  { version: "0.4.0", label: "v0.4.0 (Latest)" },
  { version: "0.3.0", label: "v0.3.0" },
  { version: "0.2.0", label: "v0.2.0" },
  { version: "0.1.0", label: "v0.1.0" },
];

// "Try it out" is gated on the same build-time signal that
// `scripts/inject-mock-server.ts` keys off (#1078) — shared via
// `lib/mock/docs-wiring` so the two can't disagree. Enabling it unconditionally
// would put Execute buttons on production GitHub Pages, where the specs carry no
// `servers:` block and nothing can serve `/api/*`: Swagger UI would resolve
// requests against the docs origin itself and answer 404s. Gating keeps
// production exactly as it is today, and means the button only appears where the
// mock is actually reachable.
const tryItOutEnabled = isMockApiEnabled();
---

<StarlightPage frontmatter={{ title: "OpenAPI docs", tableOfContents: false }}>
  <div class="version-selector">
    <label>
      API Version
      <select id="version-select">
        {
          availableVersions.map(({ version, label }) => (
            <option value={version}>{label}</option>
          ))
        }
      </select>
    </label>
  </div>

  <div id="swagger-ui" data-try-it-out={String(tryItOutEnabled)}></div>
</StarlightPage>

<style>
  /* Layout for the version selector only — Swagger's own styles (incl. its
     built-in dark theme) handle the panel itself. */
  .version-selector {
    max-width: 480px;
  }

  /* Swagger renders the version pill as `<pre class="version">`, and Starlight's
     global code-block styling gives every `pre` a `1px solid var(--sl-color-gray-5)`
     border that bleeds onto the pill. Swagger's own CSS never resets it, so strip
     it here. Scoped-component styles can't reach Swagger's JS-injected DOM, hence
     `:global`. */
  :global(.swagger-ui .version) {
    border: none;
  }

  /* Starlight caps content at `--sl-content-width` (45rem) for readable prose,
     which cramps the dense Swagger panel. Let it span the full column instead. */
  :global(.sl-container) {
    max-width: 100%;
  }

  /* Swagger's dark theme paints its own background (#1c2022) onto both `<html>`
     and the `.swagger-ui` panel, which reads as a lighter block against
     Starlight's darker body. Restore Starlight's bg on both. */
  :global(html.dark-mode),
  :global(html.dark-mode .swagger-ui) {
    background: var(--sl-color-bg) !important;
  }

  .version-selector label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }

  .version-selector select {
    padding: 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
    font-size: 16px;
    font-family: system-ui, sans-serif;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
</style>

<script>
  import { SwaggerUIBundle } from "swagger-ui-dist";
  import { resolveVersion } from "@/lib/api-docs-version";

  // Set from the build-time `MOCK_API_ENABLED` gate in this file's frontmatter.
  // Read off the mount point because client scripts are bundled, so they can't
  // close over frontmatter values directly.
  const mount = document.querySelector<HTMLElement>("#swagger-ui");
  const tryItOut = mount?.dataset.tryItOut === "true";

  const render = (version: string): void => {
    SwaggerUIBundle({
      url: `/openapi/openapi.${version}.yaml`,
      dom_id: "#swagger-ui",
      // Empty disables the Execute button entirely, which is what production
      // wants: with no mock injected there is nothing to call. The mock serves
      // GET and POST only, so those are the only methods worth enabling.
      supportedSubmitMethods: tryItOut ? ["get", "post"] : [],
      deepLinking: true,
    });
  };

  // Mirror Starlight's theme onto Swagger's built-in `.dark-mode` class so the
  // panel follows the site's light/dark toggle without any CSS overrides.
  const html = document.documentElement;
  const syncTheme = () =>
    html.classList.toggle("dark-mode", html.dataset.theme === "dark");
  syncTheme();
  new MutationObserver(syncTheme).observe(html, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // Render the version from the ?version= deep link (or the default), then keep
  // the URL in sync as the selection changes. The rendered <option>s are the
  // single source of truth for the known versions.
  const select = document.querySelector<HTMLSelectElement>("#version-select");
  if (select) {
    const availableVersions = Array.from(select.options, (o) => o.value);

    const params = new URLSearchParams(window.location.search);
    const initialVersion = resolveVersion(
      params.get("version") ?? "",
      availableVersions,
    );
    select.value = initialVersion;
    render(initialVersion);

    select.addEventListener("change", () => {
      const version = select.value;
      const url = new URL(window.location.href);
      url.searchParams.set("version", version);
      window.history.replaceState({}, "", url.toString());
      render(version);
    });
  }
</script>
