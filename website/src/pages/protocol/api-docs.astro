---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import "swagger-ui-dist/swagger-ui.css";

// Available OpenAPI versions (mirror of the emitted specs in public/openapi/)
const availableVersions = [
  { version: "0.3.0", label: "v0.3.0 (Latest)" },
  { version: "0.2.0", label: "v0.2.0" },
  { version: "0.1.0", label: "v0.1.0" },
];
---

<StarlightPage frontmatter={{ title: "OpenAPI docs", tableOfContents: false }}>
  <div class="version-selector">
    <label>
      API Version
      <select id="version-select">
        {
          availableVersions.map(({ version, label }) => (
            <option value={version}>{label}</option>
          ))
        }
      </select>
    </label>
  </div>

  <div id="swagger-ui"></div>
</StarlightPage>

<style>
  /* Layout for the version selector only — Swagger's own styles (incl. its
     built-in dark theme) handle the panel itself. */
  .version-selector {
    max-width: 480px;
  }

  /* Swagger renders the version pill as `<pre class="version">`, and Starlight's
     global code-block styling gives every `pre` a `1px solid var(--sl-color-gray-5)`
     border that bleeds onto the pill. Swagger's own CSS never resets it, so strip
     it here. Scoped-component styles can't reach Swagger's JS-injected DOM, hence
     `:global`. */
  :global(.swagger-ui .version) {
    border: none;
  }

  .version-selector label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }

  .version-selector select {
    padding: 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
    font-size: 16px;
    font-family: system-ui, sans-serif;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }
</style>

<script>
  import { SwaggerUIBundle } from "swagger-ui-dist";
  import { resolveVersion } from "@/lib/api-docs-version";

  const render = (version: string): void => {
    SwaggerUIBundle({
      url: `/openapi/openapi.${version}.yaml`,
      dom_id: "#swagger-ui",
      supportedSubmitMethods: [],
      deepLinking: true,
    });
  };

  // Mirror Starlight's theme onto Swagger's built-in `.dark-mode` class so the
  // panel follows the site's light/dark toggle without any CSS overrides.
  const html = document.documentElement;
  const syncTheme = () =>
    html.classList.toggle("dark-mode", html.dataset.theme === "dark");
  syncTheme();
  new MutationObserver(syncTheme).observe(html, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // Render the version from the ?version= deep link (or the default), then keep
  // the URL in sync as the selection changes. The rendered <option>s are the
  // single source of truth for the known versions.
  const select = document.querySelector<HTMLSelectElement>("#version-select");
  if (select) {
    const availableVersions = Array.from(select.options, (o) => o.value);

    const params = new URLSearchParams(window.location.search);
    const initialVersion = resolveVersion(
      params.get("version") ?? "",
      availableVersions,
    );
    select.value = initialVersion;
    render(initialVersion);

    select.addEventListener("change", () => {
      const version = select.value;
      const url = new URL(window.location.href);
      url.searchParams.set("version", version);
      window.history.replaceState({}, "", url.toString());
      render(version);
    });
  }
</script>
