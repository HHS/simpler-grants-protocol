  }

  :global(.swagger-ui .parameters .parameter__default i) {
    color: var(--sl-color-gray-2) !important;
  }

  :global(.swagger-ui .parameters input) {
    color: var(--sl-color-text) !important;
    background-color: var(--sl-color-background) !important;
    border-color: var(--sl-color-border) !important;
  }

  /* ######################################################### */
  /* Responses table styles */
  /* ######################################################### */

  :global(.swagger-ui .responses-table .col_header) {
    color: var(--sl-color-text) !important;
    font-weight: 600 !important;
  }

  :global(.swagger-ui .responses-table .response-col_status) {
    color: var(--sl-color-text) !important;
    font-weight: 500 !important;
  }

  :global(.swagger-ui .responses-table .response-col_description) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .responses-table .response-col_links) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .responses-table .response-control-media-type__title) {
    color: var(--sl-color-gray-2) !important;
    font-size: 0.9em !important;
  }

  :global(
    .swagger-ui .responses-table .response-control-media-type__accept-message
  ) {
    color: var(--sl-color-gray-2) !important;
    font-size: 0.9em !important;
  }

  :global(.swagger-ui .responses-table .tablinks) {
    color: var(--sl-color-gray-3) !important;
  }

  :global(.swagger-ui .responses-table .tablinks.active) {
    color: var(--sl-color-text-accent) !important;
    font-weight: 500 !important;
  }

  :global(.swagger-ui .responses-table i) {
    color: var(--sl-color-gray-2) !important;
  }

  /* ######################################################### */
  /* Tab styles */
  /* ######################################################### */

  :global(.swagger-ui .tab) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .tablinks) {
    color: var(--sl-color-gray-3) !important;
    background: none !important;
    border: none !important;
    padding: 0.5em 1em !important;
    cursor: pointer !important;
  }

  :global(.swagger-ui .tablinks.active) {
    color: var(--sl-color-text-accent) !important;
    font-weight: 500 !important;
    border-bottom: 2px solid var(--sl-color-text-accent) !important;
  }

  :global(.swagger-ui .tablinks:hover) {
    color: var(--sl-color-text) !important;
  }

  /* ######################################################### */
  /* Version styles */
  /* ######################################################### */

  :global(.swagger-ui .version) {
    border: none !important;
  }
</style>

<StarlightPage
  frontmatter={{ title: "Mock playground", tableOfContents: false }}
>
  <section class="playground-intro">
    <p>
      Every endpoint below answers from a mock running in your browser — no
      server involved. Hit <strong>Try it out</strong>, then <strong
        >Execute</strong
      >.
    </p>

    <h2>What to expect</h2>
    <ul>
      <li>
        The three opportunity endpoints are backed by a fixed set of 11 records,
        so repeat calls return the same body, and an <code>id</code> from
        <code>GET /common-grants/opportunities</code> resolves to that same record
        through <code>GET /common-grants/opportunities/{"{oppId}"}</code>. The
        pre-filled <code>oppId</code> (<code>{CANONICAL_OPPORTUNITY_ID}</code>)
        is the record the spec publishes as its own example.
      </li>
      <li>
        Search applies the <code>status</code>, close-date, and funding-range
        filters and the <code>OppSortBy</code> sort orders for real — results never
        contradict what you asked for.
      </li>
      <li>
        Every other endpoint is generated from the response schema. Those bodies
        are placeholder data, held stable for the rest of this page visit but
        reshuffled on reload.
      </li>
    </ul>

    <h2>Error responses to try</h2>
    <p>
      Each returns the protocol's <code>{"{ status, message, errors[] }"}</code> error
      envelope. Swagger UI labels the 400s "Undocumented" because the specs declare
      only 200 and 404 for these routes.
    </p>
    <table>
      <thead>
        <tr>
          <th>Request</th>
          <th>Response</th>
        </tr>
      </thead>
      <tbody>
        {
          errorCases.map((errorCase) => (
            <tr>
              <td>
                <code>{errorCase.request}</code>
              </td>
              <td>{errorCase.result}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <MockPlayground client:only="react" />
</StarlightPage>
