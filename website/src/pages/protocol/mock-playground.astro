---
// Throwaway MSW mock playground (#1034-T2). Mirrors /protocol/api-docs but
// enables Swagger UI "Try it out" and starts a Mock Service Worker so requests
// are answered client-side from the rendered OpenAPI spec. Unlinked orphan
// page (not in the nav), so starlight-links-validator needs no exclude entry.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import MockPlayground from "@/components/MockPlayground";
import {
  CANONICAL_OPPORTUNITY_ID,
  RESERVED_MISSING_OPPORTUNITY_ID,
} from "@/lib/mock/opportunities/fixtures";

// Reserved inputs that produce a non-2xx response, surfaced on the page so the
// error cases are discoverable rather than something you stumble into.
const errorCases = [
  {
    request: `GET /common-grants/opportunities/${RESERVED_MISSING_OPPORTUNITY_ID}`,
    result: "404 — a well-formed UUID that matches no opportunity",
  },
  {
    request: "GET /common-grants/opportunities/not-a-uuid",
    result: "400 — path parameter fails the uuid format",
  },
  {
    request: "GET /common-grants/opportunities?pageSize=0",
    result: "400 — page and pageSize both declare minimum: 1",
  },
  {
    request:
      'POST /common-grants/opportunities/search — sorting.sortBy: "nope"',
    result: "400 — value outside the OppSortBy enum",
  },
  {
    request:
      'POST /common-grants/opportunities/search — filters.closeDateRange.value.min: "not-a-date"',
    result: "400 — filter bound is not a valid date",
  },
];
---

<style>
  /* ######################################################### */
  /* Base container styles */
  /* ######################################################### */

  :global(.sl-container) {
    padding: 0 !important;
    max-width: 100% !important;
  }

  :global(.swagger-ui) {
    color: var(--sl-color-text) !important;
    font-family: sans-serif !important;
    background-color: var(--sl-color-background) !important;
  }

  /* ######################################################### */
  /* Intro / error-affordance guide */
  /* ######################################################### */

  /* The .sl-container padding reset above is page-wide, so the intro supplies
     its own gutter to line up with the Swagger UI content below it. */
  .playground-intro {
    padding: 1.5rem 2rem 0;
  }

  .playground-intro h2 {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.5rem;
  }

  .playground-intro table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }

  .playground-intro code {
    white-space: nowrap;
  }

  /* ######################################################### */
  /* Version selector styles */
  /* ######################################################### */

  :global(.version-selector) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem;
    background-color: var(--sl-color-background);
    border-bottom: 1px solid var(--sl-color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  :global(.version-selector label) {
    font-weight: 600;
    color: var(--sl-color-text);
    margin: 0;
  }

  :global(.version-selector select) {
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-border);
    border-radius: 0.375rem;
    background-color: var(--sl-color-background);
    color: var(--sl-color-text);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 0.15s ease-in;
  }

  :global(.version-selector select:hover) {
    border-color: var(--sl-color-text-accent);
  }

  :global(.version-selector select:focus) {
    outline: none;
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 0 0 2px var(--sl-color-accent-low);
  }

  /* ######################################################### */
  /* Basic text elements */
  /* ######################################################### */

  :global(.swagger-ui p) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui a) {
    background-color: transparent !important;
    color: var(--sl-color-text) !important;
    transition: color 0.15s ease-in !important;
  }

  :global(.swagger-ui hr) {
    border-color: var(--sl-color-border) !important;
  }

  /* ######################################################### */
  /* Info section */
  /* ######################################################### */

  :global(.swagger-ui .info .title) {
    margin-top: 0 !important;
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .url) {
    color: var(--sl-color-text-accent) !important;
    text-decoration: underline !important;
  }

  /* ######################################################### */
  /* Operation block styles */
  /* ######################################################### */

  :global(.swagger-ui .opblock-summary-path) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .opblock-summary-description) {
    color: var(--sl-color-text) !important;
  }

  /* ######################################################### */
  /* Model styles */
  /* ######################################################### */

  :global(.swagger-ui .model-title) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model-description) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model .description) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model .property) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model .property-type) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model .property-description) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model .property-name) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .models-control) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .models-control h3) {
    color: var(--sl-color-text) !important;
  }

  /* ######################################################### */
  /* Toggle arrow styles */
  /* ######################################################### */

  :global(.swagger-ui .arrow) {
    fill: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .model-toggle:after) {
    background: none !important;
    -webkit-mask: url("data:image/svg+xml;charset=utf-8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'><path d='M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z'/></svg>")
      50% no-repeat !important;
    mask: url("data:image/svg+xml;charset=utf-8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'><path d='M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z'/></svg>")
      50% no-repeat !important;
    background-color: var(--sl-color-text) !important;
  }

  /* ######################################################### */
  /* Table styles */
  /* ######################################################### */

  :global(.swagger-ui .table-container th) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .table-container td) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .table-container tr) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .table) {
    color: var(--sl-color-text) !important;
  }

  /* ######################################################### */
  /* Parameters table styles */
  /* ######################################################### */

  :global(.swagger-ui .parameters .col_header) {
    color: var(--sl-color-text) !important;
    font-weight: 600 !important;
  }

  :global(.swagger-ui .parameters .parameters-col_name) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .parameters .parameters-col_description) {
    color: var(--sl-color-text) !important;
  }

  :global(.swagger-ui .parameters .parameter__name) {
    color: var(--sl-color-text) !important;
