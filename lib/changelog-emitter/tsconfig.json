{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // Declared explicitly: automatic @types discovery stops finding node once
    // @typespec/compiler 1.14 changes the dependency layout.
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,

    /* Linting */
    "strict": true
  },
  "include": ["src", "test"]
}
