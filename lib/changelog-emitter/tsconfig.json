{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // Declared explicitly rather than relying on automatic @types discovery,
    // which stops resolving node under @typespec/compiler 1.14+.
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,

    /* Linting */
    "strict": true
  },
  "include": ["src", "test"]
}
